# =====================================================================================
# CeltIA V4 — plantilla de configuración. Copia este archivo a `.env` y sustituye los <VALORES>.
# NO subas `.env` a git (ya está en .gitignore). Usa un único archivo: si existe `.env.local`,
# sus valores GANAN sobre `.env`, incluso los vacíos (una línea `CLAVE=` vacía anula la de `.env`).
# =====================================================================================

# ---------- Modelo local (Ollama) ----------
# Crear el modelo con contexto 8192:  ollama create celtia-qwen3 -f ollama/Modelfile.celtia
VLLM_BASE_URL=http://localhost:11434/v1
MODEL_SERVE_NAME=celtia-qwen3
MODEL_CONTEXT=8192
# Docker (vLLM):  VLLM_BASE_URL=http://model:18000/v1  MODEL_NAME=openbmb/MiniCPM5-2B  MODEL_PORT=18000

# ---------- API ----------
API_PORT=8081
# URL pública (redirecciones de Stripe/OAuth). En local: http://localhost:8081
PUBLIC_BASE_URL=https://celtiaia.com
# En Windows "/data/..." se resuelve a D:\data\; en Docker es el volumen /data
SQLITE_PATH=/data/mini_council.db
LOG_LEVEL=INFO
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
PYTHON_TOOL_TIMEOUT_SECONDS=8
DATA_RETENTION_DAYS=365

# ---------- Límites del gateway ----------
GATEWAY_MAX_CONCURRENCY=1
GATEWAY_QUEUE_WAIT_SECONDS=30

# ---------- Administración ----------
# Token heredado para scripts (la UI usa la sesión de una cuenta admin). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
ADMIN_TOKEN=<TOKEN_LARGO_ALEATORIO>

# ---------- Búsqueda web ----------
BRAVE_SEARCH_API_KEY=<CLAVE_BRAVE_SEARCH>

# ---------- Stripe (modo TEST: claves sk_test_ ; para live usar sk_live_ y rehacer precios/webhook) ----------
STRIPE_SECRET_KEY=<sk_test_...>
# Secreto del endpoint https://celtiaia.com/webhooks/stripe (Dashboard → Developers → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Suscripciones mensuales (5 / 18 / 48 EUR). Deben ser precios recurrentes (mensual)
STRIPE_PRICE_BASIC=<price_...>
STRIPE_PRICE_PRO=<price_...>
STRIPE_PRICE_ULTRA=<price_...>
# Opcional: pay-as-you-go (precio con facturación por uso) y evento del medidor
STRIPE_METERED_PRICE_ID=
STRIPE_METER_EVENT_NAME=celtia_tokens
# Tokens por plan y mes
FREE_PLAN_TOKEN_GRANT=20000
BASIC_PLAN_TOKEN_GRANT=500000
PRO_PLAN_TOKEN_GRANT=2000000
ULTRA_PLAN_TOKEN_GRANT=6000000

# ---------- Imágenes (xAI · Grok Imagine) ----------
IMAGE_API_URL=https://api.x.ai/v1
IMAGE_API_KEY=<xai-...>
IMAGE_MODEL=grok-imagine-image
# Tokens descontados del saldo por cada imagen
IMAGE_TOKEN_COST=1500

# ---------- Inicio de sesión social (opcional; dejar sin la línea si no se usa) ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- Creador Studio (sandbox Docker por proyecto) ----------
CREATOR_PROJECTS_DIR=/data/projects
# Ruta ABSOLUTA en el host de la carpeta de proyectos (necesaria para montar los workspaces)
CREATOR_HOST_PROJECTS_DIR=D:/CeltIA V4-2B/data/projects
CREATOR_SANDBOX_IMAGE=node:20-slim

# ---------- Cloudflare (solo para desplegar; la app NO lo lee) ----------
# Token con permisos mínimos, ver DEPLOY.md. Bórralo cuando termines el cambio de dominio.
# CLOUDFLARE_API_TOKEN=<TOKEN_TEMPORAL>
# Token del servicio cloudflared (Zero Trust → Tunnels → celtiav2 → Configure)
# CLOUDFLARE_TUNNEL_TOKEN=<TOKEN_TUNEL>

# ---------- Hugging Face (solo si se descargan modelos por vLLM) ----------
# HUGGING_FACE_HUB_TOKEN=<hf_...>
